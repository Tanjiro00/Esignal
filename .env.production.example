POSTGRES_PASSWORD=replace-with-a-long-random-password
YOUTUBE_API_KEY=set-in-deployment-secret-manager
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://api.earlysignal.example.com/api/v1/oauth/youtube/callback
TOKEN_ENCRYPTION_KEY=
WEB_ORIGIN=https://earlysignal.example.com
PUBLIC_API_URL=https://api.earlysignal.example.com/api/v1
BACKUP_DIRECTORY=/srv/earlysignal/backups
AUTH_REQUIRED=true
AUTH_COOKIE_NAME=earlysignal_session
AUTH_COOKIE_SECURE=true
AUTH_SESSION_DAYS=30
AUTH_PASSWORD_ITERATIONS=600000
AUTH_LOGIN_WINDOW_MINUTES=10
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_BLOCK_MINUTES=15
AUTH_PEPPER=set-in-deployment-secret-manager

# Roll out one reviewed improvement slice at a time. Defaults stay false.
FEATURE_EARLYNESS_TIMELINE=false
FEATURE_SIGNAL_REVIEW_QUEUE=false
FEATURE_COMMENT_TOPIC_RELEVANCE=false
FEATURE_DECISION_EXPERIENCE=false
FEATURE_MICROTOPIC_CONTENT_GAP=false
FEATURE_FEEDBACK_EVALUATION=false
FEATURE_TOPIC_SNAPSHOT_BUCKETS=false
FEATURE_CHANNEL_PROFILE_FEASIBILITY_V2=false
FEATURE_OUTCOME_SUGGESTIONS=false
FEATURE_SIGNAL_PACKAGING=false
FEATURE_YOUTUBE_OAUTH_ANALYTICS=false
FEATURE_QUERY_EXPANSION=false
FEATURE_UX_TODAY_HOME_V1=false
FEATURE_UX_DECISION_CARD_V1=false
FEATURE_UX_SIMPLE_SCORES_V1=false
FEATURE_UX_SIMPLIFIED_NAVIGATION_V1=false
FEATURE_UX_ONBOARDING_V2=false
FEATURE_UX_OPPORTUNITY_DETAIL_V2=false
FEATURE_UX_BRIEF_V2=false
FEATURE_UX_RESULTS_V2=false
FEATURE_LLM_INTELLIGENCE=false

# Server-side only. Enable the flag only after OPENAI_API_KEY is configured.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_AUDITOR_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low
OPENAI_AUDITOR_REASONING_EFFORT=medium
OPENAI_REQUEST_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_RETRY_ATTEMPTS=2
LLM_MAX_CALLS_PER_RUN=24
LLM_MAX_RECONCILIATIONS_PER_RUN=4
LLM_MAX_TOPIC_SYNTHESES_PER_RUN=8
LLM_MAX_CONTENT_GAP_SYNTHESES_PER_RUN=6
LLM_MAX_AUDITS_PER_RUN=12
LLM_DAILY_TOKEN_BUDGET=1000000
LLM_RECONCILIATION_DAILY_TOKEN_SHARE=0.12
LLM_TOPIC_SYNTHESIS_DAILY_TOKEN_SHARE=0.25
LLM_CONTENT_GAP_DAILY_TOKEN_SHARE=0.35
LLM_WORKSPACE_DAILY_TOKEN_BUDGET=250000
LLM_REQUIRE_GROUNDING_AUDIT=true
LLM_CIRCUIT_FAILURE_THRESHOLD=3
