APP_ENV=development
DEMO_MODE=true
DATABASE_URL=sqlite:///./earlysignal.db
REDIS_URL=redis://localhost:6379/0
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
AUTH_REQUIRED=false
AUTH_COOKIE_NAME=earlysignal_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=30
AUTH_PASSWORD_ITERATIONS=600000
AUTH_LOGIN_WINDOW_MINUTES=10
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_BLOCK_MINUTES=15
AUTH_PEPPER=
RAW_PAYLOAD_RETENTION_DAYS=90
PROVIDER_DAILY_BUDGET_USD=50
PROVIDER_MONTHLY_BUDGET_USD=1500
RAW_PAYLOAD_DIRECTORY=var/raw_payloads
DISCOVERY_PROVIDER_PRIORITY=youtube_web,youtube_official
METADATA_PROVIDER_PRIORITY=youtube_official
COMMENT_PROVIDER_PRIORITY=youtube_official,youtube_web_comments
INGESTION_DEFAULT_QUERY_LIMIT=20
COMMENT_CANDIDATE_LIMIT=12
COMMENT_SAMPLE_LIMIT=100
COMMENT_REFRESH_HOURS=12
TRANSCRIPT_CANDIDATE_LIMIT=8
TRANSCRIPT_PROVIDER_PRIORITY=youtube_transcript
TRANSCRIPT_PREFERRED_LANGUAGES=en,en-US,en-GB

# EarlySignal product-improvement rollout flags. Slice 0 keeps every flag off.
FEATURE_EARLYNESS_TIMELINE=false
FEATURE_SIGNAL_REVIEW_QUEUE=false
FEATURE_COMMENT_TOPIC_RELEVANCE=false
FEATURE_DECISION_EXPERIENCE=false
FEATURE_MICROTOPIC_CONTENT_GAP=false
FEATURE_FEEDBACK_EVALUATION=false
FEATURE_TOPIC_SNAPSHOT_BUCKETS=false
FEATURE_CHANNEL_PROFILE_FEASIBILITY_V2=false
FEATURE_OUTCOME_SUGGESTIONS=false
FEATURE_SIGNAL_PACKAGING=false
FEATURE_YOUTUBE_OAUTH_ANALYTICS=false
FEATURE_QUERY_EXPANSION=false
FEATURE_UX_TODAY_HOME_V1=false
FEATURE_UX_DECISION_CARD_V1=false
FEATURE_UX_SIMPLE_SCORES_V1=false
FEATURE_UX_SIMPLIFIED_NAVIGATION_V1=false
FEATURE_UX_ONBOARDING_V2=false
FEATURE_UX_OPPORTUNITY_DETAIL_V2=false
FEATURE_UX_BRIEF_V2=false
FEATURE_UX_RESULTS_V2=false
FEATURE_LLM_INTELLIGENCE=false

# Evidence-grounded LLM synthesis. Keep the feature flag off until a server-side
# key is configured. Scores and rankings remain deterministic.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_AUDITOR_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REASONING_EFFORT=low
OPENAI_AUDITOR_REASONING_EFFORT=medium
OPENAI_REQUEST_TIMEOUT_SECONDS=45
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_RETRY_ATTEMPTS=2
LLM_MAX_CALLS_PER_RUN=24
LLM_MAX_TOPIC_SYNTHESES_PER_RUN=8
LLM_MAX_CONTENT_GAP_SYNTHESES_PER_RUN=6
LLM_MAX_AUDITS_PER_RUN=12
LLM_REQUIRE_GROUNDING_AUDIT=true
LLM_CIRCUIT_FAILURE_THRESHOLD=3

# Slice 1 does not use external credentials. Later slices may configure any
# subset of providers without making every credential mandatory.
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/oauth/youtube/callback
TOKEN_ENCRYPTION_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
SERPAPI_API_KEY=
BRIGHTDATA_API_TOKEN=
APIFY_API_TOKEN=
SUPADATA_API_KEY=
